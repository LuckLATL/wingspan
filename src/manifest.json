{
  "manifest_version": 3,
  "name": "Wingspan",
  "version": "1.0.0",
  "description": "Enhanced experience for the Cinny Matrix client.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Wingspan Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "host_permissions": [
    "https://api.klipy.com/*",
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["interceptor.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "css": ["wingspan.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["wingspan-redesign.css"],
      "matches": ["*://*/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "wingspan@cinny-extension",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
